<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>MD QUIZZES - Main Leaderboard</title>
<style>
body{
  margin:0;
  font-family:Segoe UI;
  background:#000814;
  color:white;
  text-align:center;
}

h1{color:gold;}

.leaderboard{
  max-width:600px;
  margin:40px auto;
  background:#111;
  padding:20px;
  border-radius:12px;
}
</style>
</head>

<body>

<h1>🏆 Main Leaderboard</h1>

<div id="leaderboard" class="leaderboard"></div>

<script type="module">

import { initializeApp } from "https://www.gstatic.com/firebasejs/12.9.0/firebase-app.js";
import { getFirestore, collection, query, orderBy, limit, getDocs } from "https://www.gstatic.com/firebasejs/12.9.0/firebase-firestore.js";

const firebaseConfig = {
 apiKey: "AIzaSyCODdCPvN4L96ye0YuxippaIUHnEUwnT90",
 authDomain: "mdquizzes-c255a.firebaseapp.com",
 projectId: "mdquizzes-c255a",
 storageBucket: "mdquizzes-c255a.firebasestorage.app",
 messagingSenderId: "510171455812",
 appId: "1:510171455812:web:dcead5207dc1272aa9b711"
};

const app=initializeApp(firebaseConfig);
const db=getFirestore(app);

async function loadMainLeaderboard(){
 const q=query(collection(db,"users"),
 orderBy("totalScore","desc"),
 limit(50));
 const snapshot=await getDocs(q);

 let html="<h2>Top Students</h2>";
 let rank=1;

 snapshot.forEach(doc=>{
   const d=doc.data();
   html+=`<p>#${rank} ${d.firstName} ${d.lastName} - ${d.totalScore}</p>`;
   rank++;
 });

 document.getElementById("leaderboard").innerHTML=html;
}

loadMainLeaderboard();

</script>

</body>
</html>
